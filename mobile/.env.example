# Copy to .env.local for development. These are PUBLIC build-time values (inlined into the app bundle).
# Never put secrets here: anything in a mobile app can be extracted by an attacker.
EXPO_PUBLIC_API_URL=https://api.ibuvio.app
# Base64 SHA-256 SPKI hashes of your API certificate keys (primary + backup), comma separated. Enables TLS pinning.
EXPO_PUBLIC_TLS_PINS=
