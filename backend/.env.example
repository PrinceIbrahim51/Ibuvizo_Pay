# Copy to .env (never commit it). Generate keys with the commands shown.
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL over TLS. App connects as the least-privilege role; Flyway as the schema owner.
DB_URL=jdbc:postgresql://db.example.internal:5432/ibuvio?sslmode=verify-full
DB_USERNAME=ibuvio_app
DB_PASSWORD=change-me
FLYWAY_USER=ibuvio_owner
FLYWAY_PASSWORD=change-me

# openssl rand -base64 64
JWT_SECRET=
# openssl rand -base64 32
APP_ENCRYPTION_KEY=
# openssl rand -base64 32
APP_HMAC_KEY=

# OTP delivery (must be https in prod)
OTP_SENDER=sms-gateway
SMS_GATEWAY_URL=https://sms-provider.example.com/v1/send
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=IBUVIO

# Only for a browser-based admin console; the mobile app does not need CORS
CORS_ALLOWED_ORIGINS=
# Optional: restrict /api/v1/admin/** to these IPs (comma separated)
ADMIN_ALLOWED_IPS=

# sandbox = simulated money. Switch to live only with a licensed PSP bank integration.
PSP_MODE=sandbox
VPA_HANDLE=ibuvio
